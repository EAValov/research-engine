<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <GenerateApiClientOnBuild>true</GenerateApiClientOnBuild>
    <NswagCommand Condition="'$(NswagCommand)' == ''">dotnet tool run nswag</NswagCommand>
    <NswagConfigFile>Api\nswag.json</NswagConfigFile>
    <OpenApiSpecFile>Api\v1.yaml</OpenApiSpecFile>
    <GeneratedApiClientFile>Api\ResearchApiClient.g.cs</GeneratedApiClientFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Condition="'$(GenerateApiClientOnBuild)' == 'true'">
    <ProjectReference Include="..\ResearchEngine.API\ResearchEngine.API.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <Target Name="GenerateResearchApiClient" BeforeTargets="CoreCompile" Condition="'$(GenerateApiClientOnBuild)' == 'true' and '$(DesignTimeBuild)' != 'true'" Inputs="$(MSBuildProjectDirectory)\$(NswagConfigFile);$(MSBuildProjectDirectory)\$(OpenApiSpecFile);$(MSBuildProjectDirectory)\..\.config\dotnet-tools.json" Outputs="$(MSBuildProjectDirectory)\$(GeneratedApiClientFile)">
    <Exec Command="$(NswagCommand) run &quot;$(NswagConfigFile)&quot; /variables:OpenApiSpecFile=$([System.IO.Path]::GetFileName('$(OpenApiSpecFile)'))" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
